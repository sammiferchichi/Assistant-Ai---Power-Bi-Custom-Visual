# Copy this file to .env and fill your own keys. NEVER commit .env
# GEMINI: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=put-your-gemini-key-here
# GROQ: https://console.groq.com/keys
GROQ_API_KEY=put-your-groq-key-here

# Local LLM (Ollama) — no key needed
# Install: https://ollama.com — then: ollama pull llama3.1 && ollama serve
LOCAL_LLM_URL=http://localhost:11434/api/chat
LOCAL_LLM_MODEL=llama3.1

PORT=3000
